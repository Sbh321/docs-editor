{
  "name": "playground-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test:e2e": "playwright test",
    "test:perf": "DOCS_EDITOR_PERF=1 playwright test --reporter=list",
    "clean": "rm -rf dist .tsbuild playwright-report test-results"
  },
  "dependencies": {
    "@sbh321/docs-editor-core": "workspace:*",
    "@sbh321/docs-editor-docx": "workspace:*",
    "@sbh321/docs-editor-icons": "workspace:*",
    "@sbh321/docs-editor-markdown": "workspace:*",
    "@sbh321/docs-editor-react": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@docs-editor/eslint-config": "workspace:*",
    "@docs-editor/typescript-config": "workspace:*",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "vite": "8.1.4"
  }
}
