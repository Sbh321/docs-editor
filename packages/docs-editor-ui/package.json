{
  "name": "@sbh321/docs-editor",
  "version": "0.1.0",
  "description": "Batteries-included, styled editor built on Docs Editor.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sbh321/docs-editor.git",
    "directory": "packages/docs-editor-ui"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuild"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.16",
    "@sbh321/docs-editor-core": "workspace:*",
    "@sbh321/docs-editor-docx": "workspace:*",
    "@sbh321/docs-editor-icons": "workspace:*",
    "@sbh321/docs-editor-markdown": "workspace:*",
    "@sbh321/docs-editor-react": "workspace:*"
  },
  "devDependencies": {
    "@docs-editor/eslint-config": "workspace:*",
    "@docs-editor/typescript-config": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
