{
  "name": "docs-editor",
  "private": true,
  "version": "0.0.0",
  "description": "Docs Editor monorepo \u2014 a professional, headless, framework-agnostic document editor.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "bench": "turbo run bench",
    "size": "node scripts/measure-bundle-size.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "husky",
    "size:check": "node scripts/measure-bundle-size.mjs --check"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@docs-editor/eslint-config": "workspace:*",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "tsup": "8.5.1",
    "turbo": "2.10.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  }
}
